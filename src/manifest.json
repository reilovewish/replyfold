{
  "manifest_version": 3,
  "name": "Replyfold",
  "version": "0.1.0",
  "description": "返信を別ウインドウでなく、メール表示エリアの下端のパネルで書く",
  "icons": {
    "32": "icons/replyfold.svg",
    "64": "icons/replyfold.svg",
    "128": "icons/replyfold.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "replyfold@reilovewish.com",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "compose_action": {
    "default_title": "パネルに戻す",
    "default_label": "パネルに戻す",
    "default_icon": "icons/dock.svg"
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesModify",
    "scripting",
    "compose",
    "compose.send",
    "storage"
  ]
}
